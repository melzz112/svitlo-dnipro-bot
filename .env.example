# Токен від @BotFather
BOT_TOKEN=

# dtek: сайт ДТЕК, потім YASNO для ДТЕК. yasno: одразу YASNO. demo: тестові графіки.
# Для ЦЕК використовуємо YASNO. Резервне джерело для обох постачальників — Telegram.
SOURCE=dtek
CITY=dnipro

# --- Юзербот (читання чатів), отримати на https://my.telegram.org ---
API_ID=
API_HASH=
# Канали-агрегатори: пости -> сповіщення; коментарі під ними (група обговорення) підхоплюються самі
CHANNELS=@vklyuchatel_dnepr_svet,@avariycka1,@dniproavariyka
# Додаткові чати, де пишуть люди. Без @username: числовий ID (-100…, див. python userbot.py --list)
# або інвайт-посилання https://t.me/+xxxx
CHATS=

# --- Екстрені по групах: «Перевірити адресу» на сайті ДТЕК (працює з SOURCE=dtek) ---
# Вулиці Дніпра, де бот щохвилини дивиться всі будинки: у кожного видно чергу і чи є зараз світло.
# Порожньо — вбудований список довгих вулиць. Чи всі 12 груп покриті: python dtek_site.py
DTEK_STREETS=
# Як часто перевіряти, секунд (0 — вимкнути)
DTEK_PROBE_SEC=180

# Telegram ID тих, кому доступна /stats (через кому). Порожньо — нікому
ADMIN_IDS=
