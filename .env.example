# Токен від @BotFather
BOT_TOKEN=

# dtek: графіки з YASNO (далі outage-data-ua, сайт ДТЕК — лише в крайньому разі) + перевірка адрес на сайті ДТЕК.
# yasno: лише YASNO. demo: тестові графіки.
# Для ЦЕК використовуємо YASNO. Резервне джерело для обох постачальників — Telegram.
SOURCE=dtek
CITY=dnipro

# --- Юзербот (читання чатів), отримати на https://my.telegram.org ---
API_ID=
API_HASH=
# Канали-агрегатори: пости -> сповіщення; коментарі під ними (група обговорення) підхоплюються самі
CHANNELS=@vklyuchatel_dnepr_svet,@avariycka1,@dniproavariyka
# Додаткові чати, де пишуть люди. Без @username: числовий ID (-100…, див. python userbot.py --list)
# або інвайт-посилання https://t.me/+xxxx
CHATS=

# --- Сайт ДТЕК, «Перевірити адресу» (працює з SOURCE=dtek) ---
# Повний довідник вулиць і будинків збирається з ПК з українським IP: python scripts/seed_streets.py
# і переноситься на сервер (таблиці dtek_streets / dtek_houses у svitlo.db). Сервер опитує лише вулиці,
# де є підписники, раз на DTEK_POLL_INTERVAL_SEC, з паузою DTEK_POLL_PAUSE_MIN…MAX с між запитами.
DTEK_POLL_INTERVAL_SEC=1800
DTEK_POLL_PAUSE_MIN=3
DTEK_POLL_PAUSE_MAX=5
# Помилка чи антибот -> стільки секунд жодного запиту до сайту ДТЕК
DTEK_BACKOFF_SEC=1800
# Додаткові контрольні вулиці (через кому). Порожньо — лише вулиці підписників
DTEK_STREETS=
# Проксі не потрібен (curl_cffi з відбитком Chrome). Опційно: http://user:pass@host:port або socks5://…
DTEK_PROXY=

# Telegram ID тих, кому доступна /stats (через кому). Порожньо — нікому
ADMIN_IDS=

# --- Світлобот: датчики світла по Дніпру (фактичний стан кожної групи ДТЕК і ЦЕК) ---
SVITLOBOT_ENABLED=true
SVITLOBOT_TOKEN_URL=https://api.svitlobot.in.ua/website/getMapToken
SVITLOBOT_CHANNELS_URL=https://api.svitlobot.in.ua/website/getChannelsForMap
# Як часто опитувати, секунд
SVITLOBOT_POLL_INTERVAL=120
# Регіон у підписі групи точки («Дніпро (ДТЕК) — група 5.1»; «Група 1.1» без регіону — інші області)
# Лише точки цього міста (слово в адресі до «->»)
SVITLOBOT_REGION=Дніпро
SVITLOBOT_CITY_FILTER=Дніпро
# Мінімум живих точок у групі, щоб робити висновок
SVITLOBOT_MIN_SENSORS=2
# Частка точок зі світлом: >= ON -> «світло є», <= OFF -> «світла немає», між ними — лишаємо попередній стан
SVITLOBOT_ON_THRESHOLD=0.65
SVITLOBOT_OFF_THRESHOLD=0.35
