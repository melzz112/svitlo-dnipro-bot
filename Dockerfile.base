# Базовий образ: Python, Chromium і залежності. Перезбирається лише коли змінились requirements.txt чи цей файл
# (deploy/server_update.sh), тож звичайна викатка коду не потребує ні Docker Hub, ні PyPI.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
# лише Chromium без рекомендованих пакетів — для короткої браузерної сесії ДТЕК (кукі Incapsula)
RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
ENV CHROME_EXECUTABLE_PATH=/usr/bin/chromium
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
